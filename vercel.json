{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "admin.html",
      "use": "@vercel/static"
    },
    {
      "src": "robots.txt",
      "use": "@vercel/static"
    },
    {
      "src": "image/**",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    },
    {
      "src": "*.js",
      "use": "@vercel/static"
    },
    {
      "src": "llms.txt",
      "use": "@vercel/static"
    },
    {
      "src": "api/*.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "index.html",
          "lib/**",
          "kommentarer/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/admin/?",
      "dest": "/admin.html"
    },
    {
      "src": "/innlegg/(?<slug>[^/?#]+)/?",
      "dest": "/api/innlegg.js?slug=$slug"
    },
    {
      "src": "/tema/?",
      "dest": "/api/tema.js"
    },
    {
      "src": "/tema/(?<slug>[^/?#]+)/?",
      "dest": "/api/tema.js?slug=$slug"
    },
    {
      "src": "/om-oss/?",
      "dest": "/api/om.js"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/api/sitemap.js"
    },
    {
      "src": "/(rss\\.xml|feed|rss)/?",
      "dest": "/api/rss.js"
    },
    {
      "src": "/llms.txt",
      "dest": "/llms.txt"
    },
    {
      "src": "/robots.txt",
      "dest": "/robots.txt"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
